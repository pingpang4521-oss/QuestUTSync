<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <AssemblyName>tracker_setup_lite</AssemblyName>
    <RootNamespace>QuestUTSync</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <Authors>pingpang4521-oss</Authors>
    <Description>Automatic Vive Ultimate Tracker to Meta Quest playspace synchronizer for SteamVR</Description>
    <PackageProjectUrl>https://github.com/pingpang4521-oss/QuestUTSync</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pingpang4521-oss/QuestUTSync</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="lib\openvr_api.dll" Condition="Exists('lib\openvr_api.dll')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="C:\Program Files\VIVE Hub\VIVE Ultimate Tracker\ViveUTServer\openvr_api.dll"
          Condition="!Exists('lib\openvr_api.dll') and Exists('C:\Program Files\VIVE Hub\VIVE Ultimate Tracker\ViveUTServer\openvr_api.dll')"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
